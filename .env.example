# Rupaantar WhatsApp Mini-Store Environment Variables
# Copy this file to .env or set these in your deployment platform (Vercel / Netlify / Render)

# Official Business WhatsApp Number (digits only, country code included, e.g. 919876543210 for India)
WHATSAPP_BUSINESS_NUMBER=919876543210

# Store Details
STORE_NAME=Rupantar
STORE_TAGLINE=An ode to India, reimagined.
STORE_INSTAGRAM=@projectrupaantar

# Delivery Configuration
DELIVERY_FEE=60
FREE_DELIVERY_THRESHOLD=799
