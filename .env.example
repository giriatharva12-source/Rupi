# ==============================================================================
# Rupaantar Store — Environment Variables Configuration
# ==============================================================================
# IMPORTANT:
# - Variable names only are documented here. NEVER commit real secrets to Git.
# - Copy this file to .env for local testing or configure in Vercel / hosting platform.
# ==============================================================================

# 1. Razorpay Payment Gateway Credentials (Sandbox / Test Mode)
# Obtain test credentials from Razorpay Dashboard: Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# 2. Store Admin Passcode / Authorization Key
# Protects the staff order management dashboard and status update APIs
ADMIN_API_KEY=rupantar_admin_secure_passcode

# 3. WhatsApp Business Routing
# Registered WhatsApp business phone number (country code + 10 digits, no + or spaces)
WHATSAPP_BUSINESS_NUMBER=919876543210

# 4. Store Branding & Policy
STORE_NAME=Rupantar
STORE_TAGLINE=An ode to India, reimagined.
STORE_INSTAGRAM=@projectrupaantar

# 5. Shipping / Delivery Configuration
DELIVERY_FEE=60
FREE_DELIVERY_THRESHOLD=799

# 6. Server Runtime
PORT=3000
NODE_ENV=development
